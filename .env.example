# Шаблон файла с ключами. Скопируйте: cp .env.example .env и впишите значения в .env.
# .env в .gitignore, коммитить его нельзя. Значения пишутся без кавычек.

# ---------- GigaChat (Сбер) ----------
# Ключ авторизации (Authorization key, строка base64 из client_id:client_secret).
# Где взять: https://developers.sber.ru/studio → создать проект GigaChat API →
# «Настройки API» → «Получить ключ». Ключ показывается один раз, сохраните его сразу.
GIGACHAT_CREDENTIALS=
# Версия API: GIGACHAT_API_PERS для физлиц (бесплатный лимит), GIGACHAT_API_B2B / GIGACHAT_API_CORP для юрлиц.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Проверка TLS-сертификата сервера. Серверы GigaChat подписаны сертификатом НУЦ Минцифры.
# Вариант 1 (правильный): скачать корневой сертификат «Russian Trusted Root CA»
#   (https://www.gosuslugi.ru/crt) и указать путь к .crt/.pem в GIGACHAT_CA_BUNDLE_FILE.
# Вариант 2 (упрощённый): GIGACHAT_VERIFY_SSL_CERTS=False. Это нужно указать в ограничениях отчёта.
# Имена переменных совпадают с теми, что читает SDK gigachat (префикс GIGACHAT_).
GIGACHAT_VERIFY_SSL_CERTS=True
GIGACHAT_CA_BUNDLE_FILE=

# ---------- YandexGPT (Yandex AI Studio) ----------
# API-ключ сервисного аккаунта. Где взять: https://console.yandex.cloud → каталог →
# «Сервисные аккаунты» → создать аккаунт с ролью ai.languageModels.user →
# «Создать новый ключ» → «Создать API-ключ». Секрет показывается один раз.
YANDEX_API_KEY=
# Идентификатор каталога (folder_id): в консоли Yandex Cloud, на странице каталога, вида b1g...
# Нужен для имени модели gpt://<folder_id>/yandexgpt/latest.
YANDEX_FOLDER_ID=

# ---------- Большая открытая / зарубежная модель ----------
# DeepSeek: https://platform.deepseek.com → API keys → Create new API key (нужно пополнить баланс).
DEEPSEEK_API_KEY=
# Альтернатива — Qwen через Alibaba Cloud Model Studio (DashScope):
# https://modelstudio.console.alibabacloud.com → API Key. Заполнять, только если выбран Qwen вместо DeepSeek.
DASHSCOPE_API_KEY=

# ---------- Локальная модель (Ollama) ----------
# Ключ не нужен. Ollama ставится через `brew install ollama`, сервис запускается командой
# `brew services start ollama`, модель скачивается командой `ollama pull qwen3:8b`.
# OpenAI-совместимый endpoint локального сервера:
OLLAMA_BASE_URL=http://localhost:11434/v1
